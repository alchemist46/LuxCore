# Generate the sources embedding the pre-compiled HIP kernels: one source file
# per code object (the binary in hexadecimal format) and embeddedhip.cpp with
# the registry mapping the kernel key and the family of architectures to the
# code objects. FAMILIES is the list of the families (separated by "|", as
# a CMake list can't be passed on the command line).

if(NOT DEFINED INPUT_DIR OR NOT DEFINED OUTPUT_DIR OR NOT DEFINED FAMILIES)
  message(FATAL_ERROR "Usage: cmake -DINPUT_DIR=... -DOUTPUT_DIR=... -DFAMILIES=... -P GenerateEmbeddedHIP.cmake")
endif()

string(REPLACE "|" ";" HIP_FAMILIES "${FAMILIES}")

# The MSVC C2026 ('string too big') limit on a string literal is 16380
# bytes: stay safely below it (GCC and Clang have much higher limits)
set(MAX_STRING_LITERAL_SIZE 16000)

file(STRINGS ${INPUT_DIR}/hipmanifest.txt HIP_MANIFEST)

set(HIP_REGISTRY_DECLARATIONS "")
set(HIP_REGISTRY_ENTRIES "")

foreach(HIP_MANIFEST_LINE ${HIP_MANIFEST})
  separate_arguments(HIP_MANIFEST_FIELDS UNIX_COMMAND "${HIP_MANIFEST_LINE}")
  list(GET HIP_MANIFEST_FIELDS 0 HIP_VARIANT_NAME)
  list(GET HIP_MANIFEST_FIELDS 1 HIP_VARIANT_KEY)

  foreach(HIP_FAMILY ${HIP_FAMILIES})
    set(HIP_MODULE_NAME ${HIP_VARIANT_NAME}_${HIP_FAMILY})
    string(MAKE_C_IDENTIFIER ${HIP_MODULE_NAME} HIP_MODULE_ID)

    # Read the code object in hexadecimal format
    file(READ ${INPUT_DIR}/${HIP_MODULE_NAME}.co HIP_MODULE_HEX HEX)

    # Write the module source file
    set(HIP_MODULE_FILE ${OUTPUT_DIR}/${HIP_MODULE_NAME}_module.cpp)
    file(WRITE ${HIP_MODULE_FILE} "// Generated by GenerateEmbeddedHIP.cmake -- do not edit\n\n")
    file(APPEND ${HIP_MODULE_FILE} "#include <cstddef>\n#include <string>\n\n")
    file(APPEND ${HIP_MODULE_FILE} "namespace luxrays { namespace hipregistry {\n\n")
    # Note: the chunks are stored in an array and joined at run time (and not
    # as adjacent string literals, which the MSVC C2026 limit of 65535 bytes
    # on concatenated literals doesn't allow)
    file(APPEND ${HIP_MODULE_FILE} "const std::string &Get_${HIP_MODULE_ID}() {\n")
    file(APPEND ${HIP_MODULE_FILE} "\tstatic const char *const hexChunks[] = {\n")

    string(LENGTH "${HIP_MODULE_HEX}" HIP_MODULE_HEX_SIZE)
    set(HIP_MODULE_HEX_POS 0)
    while(HIP_MODULE_HEX_POS LESS HIP_MODULE_HEX_SIZE)
      string(SUBSTRING "${HIP_MODULE_HEX}" ${HIP_MODULE_HEX_POS} ${MAX_STRING_LITERAL_SIZE} HIP_MODULE_HEX_CHUNK)
      file(APPEND ${HIP_MODULE_FILE} "\t\t\"${HIP_MODULE_HEX_CHUNK}\",\n")
      math(EXPR HIP_MODULE_HEX_POS "${HIP_MODULE_HEX_POS} + ${MAX_STRING_LITERAL_SIZE}")
    endwhile()
    file(APPEND ${HIP_MODULE_FILE} "\t};\n\n")
    file(APPEND ${HIP_MODULE_FILE} "\tstatic const std::string module = [] {\n")
    file(APPEND ${HIP_MODULE_FILE} "\t\tstd::string hex;\n")
    file(APPEND ${HIP_MODULE_FILE} "\t\tfor (const char *chunk : hexChunks)\n")
    file(APPEND ${HIP_MODULE_FILE} "\t\t\thex += chunk;\n")
    file(APPEND ${HIP_MODULE_FILE} "\t\treturn hex;\n")
    file(APPEND ${HIP_MODULE_FILE} "\t}();\n\n\treturn module;\n}\n\n}\n}\n")

    # Add the module to the registry
    set(HIP_REGISTRY_DECLARATIONS "${HIP_REGISTRY_DECLARATIONS}const std::string &Get_${HIP_MODULE_ID}();\n")
    set(HIP_REGISTRY_ENTRIES "${HIP_REGISTRY_ENTRIES}\t\t{ \"${HIP_VARIANT_KEY}_${HIP_FAMILY}\", &hipregistry::Get_${HIP_MODULE_ID} },\n")
  endforeach()
endforeach()

# Write the registry source file
file(WRITE ${OUTPUT_DIR}/embeddedhip.cpp "// Generated by GenerateEmbeddedHIP.cmake -- do not edit\n\n")
file(APPEND ${OUTPUT_DIR}/embeddedhip.cpp [[#include <cstddef>
#include <memory>
#include <mutex>
#include <string>
#include <unordered_map>

#include "luxrays/utils/embeddedhip.h"

namespace luxrays {

namespace hipregistry {
]])
file(APPEND ${OUTPUT_DIR}/embeddedhip.cpp "\n${HIP_REGISTRY_DECLARATIONS}\n}\n\n")
file(APPEND ${OUTPUT_DIR}/embeddedhip.cpp [[namespace {

typedef const std::string & (*HIPKernelGetter)();

std::string HexDecode(const std::string &hex) {
	std::string decoded(hex.size() / 2, '\0');
	for (std::size_t i = 0; i < decoded.size(); ++i) {
		const int high = (hex[2 * i] <= '9') ? (hex[2 * i] - '0') : (hex[2 * i] - 'a' + 10);
		const int low = (hex[2 * i + 1] <= '9') ? (hex[2 * i + 1] - '0') : (hex[2 * i + 1] - 'a' + 10);
		decoded[i] = static_cast<char>(high * 16 + low);
	}
	return decoded;
}

const std::unordered_map<std::string, HIPKernelGetter> &GetRegistry() {
	static const std::unordered_map<std::string, HIPKernelGetter> registry = {
]])
file(APPEND ${OUTPUT_DIR}/embeddedhip.cpp "${HIP_REGISTRY_ENTRIES}")
file(APPEND ${OUTPUT_DIR}/embeddedhip.cpp [[	};
	return registry;
}

}

const unsigned char *GetEmbeddedHIPKernel(const std::string &key, const std::string &family,
		std::size_t *size) {
	static std::mutex kernelMutex;
	static std::unordered_map<std::string, std::unique_ptr<std::string>> kernels;

	const std::string name = key + "_" + family;
	const auto &registry = GetRegistry();
	const auto it = registry.find(name);
	if (it == registry.end()) {
		if (size)
			*size = 0;
		return nullptr;
	}

	// Decode the code object only once
	std::lock_guard<std::mutex> lock(kernelMutex);

	std::unique_ptr<std::string> &kernel = kernels[name];
	if (!kernel)
		kernel = std::make_unique<std::string>(HexDecode(it->second()));

	if (size)
		*size = kernel->size();
	return reinterpret_cast<const unsigned char *>(kernel->data());
}

bool HasEmbeddedHIPKernels() {
	return !GetRegistry().empty();
}

}
]])
