//------------------------------------------------------------------------------
// The energy conservation of the cloth specular
//
// The Irawan-Marschner weave model is a fit, not a conserving BSDF: its
// specular part (normalized so that its albedo averaged over the view
// directions is 1, ClothMaterial::SetPreset()) reflects up to 2.5 times the
// light it receives at grazing view angles, depending on the azimuth too (the
// direction of the yarns). The table is the directional albedo E of that
// specular part per preset, averaged over the weave tile, per view direction
// in the shading frame (CLOTH_ALBEDO_MU_COUNT cosines and
// CLOTH_ALBEDO_PHI_COUNT azimuths, at the bin centres). The specular part is
// divided by E where E > 1, so that it never reflects more than it receives,
// and left as it is elsewhere (dark head-on: the model absorbs there).
//
// The table is generated by "bsdftest --cloth-albedo-table <this file>"
// (tests/bsdf/bsdftest.cpp, from ClothMaterial::SpecularAlbedo()); run it
// again after a change of the weave model or of the presets.
//------------------------------------------------------------------------------

#define CLOTH_ALBEDO_PRESET_COUNT 6
#define CLOTH_ALBEDO_MU_COUNT 16
#define CLOTH_ALBEDO_PHI_COUNT 32

// [preset][mu][phi]
__constant float ClothSpecularAlbedoTable[CLOTH_ALBEDO_PRESET_COUNT * CLOTH_ALBEDO_MU_COUNT * CLOTH_ALBEDO_PHI_COUNT] = {
