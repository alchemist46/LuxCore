// The directional albedo of the specular part of the preset at the eye
// direction (local, either side: the model mirrors the directions above the
// surface)
OPENCL_FORCE_INLINE float ClothMaterial_SpecularAlbedo(const ClothPreset preset, const float3 localEyeDir) {
	const float3 w = (localEyeDir.z < 0.f) ? -localEyeDir : localEyeDir;

	// The cosine bins, clamped at the ends
	const float x = clamp(w.z * CLOTH_ALBEDO_MU_COUNT - .5f, 0.f, CLOTH_ALBEDO_MU_COUNT - 1.f);
	const int i0 = min((int)x, CLOTH_ALBEDO_MU_COUNT - 2);
	const float fx = x - i0;

	// The azimuth bins, periodic
	float phi = atan2(w.y, w.x);
	if (phi < 0.f)
		phi += 2.f * M_PI_F;
	const float y = phi * (CLOTH_ALBEDO_PHI_COUNT / (2.f * M_PI_F)) - .5f;
	const float yFloor = floor(y);
	const float fy = y - yFloor;
	const int j0 = (((int)yFloor) % CLOTH_ALBEDO_PHI_COUNT + CLOTH_ALBEDO_PHI_COUNT) % CLOTH_ALBEDO_PHI_COUNT;
	const int j1 = (j0 + 1) % CLOTH_ALBEDO_PHI_COUNT;

	__constant float *t = &ClothSpecularAlbedoTable[(int)preset * CLOTH_ALBEDO_MU_COUNT * CLOTH_ALBEDO_PHI_COUNT];
	__constant float *r0 = &t[i0 * CLOTH_ALBEDO_PHI_COUNT];
	__constant float *r1 = &t[(i0 + 1) * CLOTH_ALBEDO_PHI_COUNT];
	const float e0 = r0[j0] + fy * (r0[j1] - r0[j0]);
	const float e1 = r1[j0] + fy * (r1[j1] - r1[j0]);

	return e0 + fx * (e1 - e0);
}

// The factor of the specular part at the eye direction: 1 / E where the
// albedo E is above 1
OPENCL_FORCE_INLINE float ClothMaterial_SpecularConservation(const ClothPreset preset, const float3 localEyeDir) {
	const float e = ClothMaterial_SpecularAlbedo(preset, localEyeDir);

	return (e > 1.f) ? (1.f / e) : 1.f;
}

